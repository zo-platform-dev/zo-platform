# =============================================================================
# ZO Platform - Environment Configuration
# =============================================================================
# ⚠️ SECURITY WARNING: This file contains template values!
# Generate secure secrets before deployment:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
# Copy this file to .env and fill in your values

# ===================
# Server Configuration
# ===================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ===================
# Database (MongoDB)
# ===================
MONGODB_URI=mongodb://localhost:27017/zo-platform
MONGODB_USER=
MONGODB_PASSWORD=

# ===================
# Redis (Queue & Cache)
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================
# Authentication
# ===================
# ⚠️ IMPORTANT: Change these to secure values before production deployment!
# JWT_SECRET must be at least 32 characters
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS
JWT_EXPIRES_IN=7d
# ⚠️ IMPORTANT: Change this to a secure value before production deployment!
# API_KEY_SECRET must be at least 32 characters
API_KEY_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS

# ===================
# Scraping Configuration
# ===================
PUPPETEER_EXECUTABLE_PATH=
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
REQUEST_TIMEOUT=30000
MAX_CONCURRENT_TASKS=5

# ===================
# Proxy Configuration
# ===================
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=500

# ===================
# Email (Notifications)
# ===================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zo-platform.com

# ===================
# Data Export
# ===================
EXPORT_MAX_ROWS=100000
EXPORT_PATH=./exports

# ===================
# Logging
# ===================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ===================
# n8n Integration
# ===================
N8N_WEBHOOK_SECRET=
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_CRON=0 0 * * *